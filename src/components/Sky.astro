---
import { Image } from 'astro:assets';
import planet from '../assets/planet-obsidian.png';

const { quiet = false } = Astro.props;
/**
 * 배경 하늘. 별 두 겹이 아주 느리게 흐르고,
 * 별똥별 둘이 아래에서 위로 솟고, 오른쪽 아래에는 흑요석 행성이 걸려 있다.
 * 행성 이미지는 빌드할 때 WebP로 최적화하고, 고리와 암석 공전은 CSS로 그린다.
 */
---

<div class={`sky${quiet ? ' quiet' : ''}`} aria-hidden="true">
  <div class="layer1"></div>
  <div class="layer2"></div>

  <div class="shoot s1">
    <svg width="150" height="120" viewBox="0 0 150 120" fill="none">
      <defs>
        <linearGradient id="tail1" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity=".9" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M132 10L14 110" stroke="url(#tail1)" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="132" cy="10" r="1.9" fill="#fff" />
    </svg>
  </div>

  <div class="shoot s2">
    <svg width="112" height="90" viewBox="0 0 112 90" fill="none">
      <defs>
        <linearGradient id="tail2" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffe9cf" stop-opacity=".8" />
          <stop offset="100%" stop-color="#ffe9cf" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M99 8L11 82" stroke="url(#tail2)" stroke-width="1.3" stroke-linecap="round" />
      <circle cx="99" cy="8" r="1.6" fill="#fff3e2" />
    </svg>
  </div>

  <div class="planet-system">
    <div class="orbit-plane orbit-plane-back">
      <span class="orbit-ring orbit-ring-wide"></span>
      <span class="orbit-ring orbit-ring-inner"></span>
      <span class="orbit-rock" style="--rock-size: 12px; --orbit-time: 47s; --orbit-delay: -31s;"></span>
      <span class="orbit-rock" style="--rock-size: 7px; --orbit-time: 61s; --orbit-delay: -17s;"></span>
      <span class="orbit-rock" style="--rock-size: 16px; --orbit-time: 73s; --orbit-delay: -52s;"></span>
    </div>

    <Image
      class="planet"
      src={planet}
      alt=""
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />

    <div class="orbit-plane orbit-plane-front">
      <span class="orbit-ring orbit-ring-wide"></span>
      <span class="orbit-ring orbit-ring-inner"></span>
      <span class="orbit-rock" style="--rock-size: 15px; --orbit-time: 54s; --orbit-delay: -8s;"></span>
      <span class="orbit-rock" style="--rock-size: 8px; --orbit-time: 39s; --orbit-delay: -27s;"></span>
      <span class="orbit-rock" style="--rock-size: 19px; --orbit-time: 68s; --orbit-delay: -43s;"></span>
      <span class="orbit-rock" style="--rock-size: 5px; --orbit-time: 33s; --orbit-delay: -19s;"></span>
    </div>
  </div>
</div>
