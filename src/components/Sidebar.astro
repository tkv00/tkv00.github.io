---
import { getCollection } from 'astro:content';
import { site, author, nav, projectOrder, analytics } from '../site.config.mjs';

const { path = '/' } = Astro.props;

const posts = (await getCollection('posts')).filter((p) => !p.data.draft);

/** 프로젝트·카테고리별 글 수를 센다. 설정에 적힌 순서를 먼저 따르고, 나머지는 많은 순. */
const tally = (key) => {
  const m = new Map();
  for (const p of posts) {
    const v = p.data[key];
    if (v) m.set(v, (m.get(v) ?? 0) + 1);
  }
  return [...m.entries()];
};

const projects = tally('project').sort((a, b) => {
  const ia = projectOrder.indexOf(a[0]);
  const ib = projectOrder.indexOf(b[0]);
  if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  return b[1] - a[1];
});
const categories = tally('category').sort((a, b) => b[1] - a[1]);

const here = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<aside class="rail">
  <a class="brand" href="/">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7.6" fill="#1c1f26" stroke="rgba(255,255,255,.18)" />
      <circle cx="8.4" cy="8.6" r="1.5" fill="rgba(255,255,255,.11)" />
      <circle cx="13.4" cy="12.6" r="2.1" fill="rgba(255,255,255,.07)" />
      <path d="M11 1.2v2.2M11 18.6v2.2M1.2 11h2.2M18.6 11h2.2" stroke="#d9bc90" stroke-opacity=".55" stroke-linecap="round" />
    </svg>
    <b>{site.title}</b>
    <span>{site.latin}</span>
  </a>

  <div class="who">
    <div class="ava">
      <svg width="76" height="76" viewBox="0 0 76 76" fill="none" style="position:absolute;inset:0;" aria-hidden="true">
        <circle class="ring" cx="38" cy="38" r="37" stroke="#d9bc90" stroke-opacity=".5" />
        <g class="orb"><circle cx="38" cy="1" r="2.1" fill="#d9bc90" /></g>
      </svg>
      {author.avatar ? (
        <img src={author.avatar} alt={author.name} width="66" height="66" />
      ) : (
        <svg width="66" height="66" viewBox="0 0 66 66" fill="none" style="position:absolute;left:5px;top:5px;" aria-hidden="true">
          <defs>
            <radialGradient id="moon" cx="32%" cy="26%" r="80%">
              <stop offset="0%" stop-color="#434854" />
              <stop offset="60%" stop-color="#24272e" />
              <stop offset="100%" stop-color="#14161a" />
            </radialGradient>
          </defs>
          <circle cx="33" cy="33" r="33" fill="url(#moon)" />
          <circle cx="22" cy="24" r="6.2" fill="rgba(255,255,255,.05)" />
          <circle cx="42" cy="40" r="9" fill="rgba(0,0,0,.18)" />
          <circle cx="45" cy="19" r="3.4" fill="rgba(255,255,255,.04)" />
          <circle cx="25" cy="46" r="4.4" fill="rgba(0,0,0,.14)" />
        </svg>
      )}
    </div>

    <div style="display:flex;flex-direction:column;gap:6px;">
      <span class="nm">{author.name}</span>
      <span class="rl">{author.role}</span>
    </div>

    <p>{author.bio}</p>

    <div class="social">
      <a href={`https://github.com/${author.github}`} rel="me noopener" target="_blank" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.2-4.6-5.1 0-1.1.4-2 1-2.8-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 014.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.8 1 1.7 1 2.8 0 3.9-2.3 4.8-4.6 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0022 12.2C22 6.6 17.5 2 12 2z" /></svg>
      </a>
      <a href={`mailto:${author.email}`} aria-label="메일">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2.6" y="4.8" width="18.8" height="14.4" rx="2.4" /><path d="M3.6 6.6L12 12.8l8.4-6.2" /></svg>
      </a>
      <a href="/rss.xml" aria-label="RSS">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 019 9" /><path d="M4 4a16 16 0 0116 16" /><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" /></svg>
      </a>
    </div>
  </div>

  <nav class="group">
    {nav.map((n) => (
      <a class="nv" href={n.href} aria-current={here(n.href) ? 'page' : undefined}>
        <i></i>{n.label}
        {n.href === '/posts' && <span class="ct">{posts.length}</span>}
      </a>
    ))}
  </nav>

  {projects.length > 0 && (
    <nav class="group">
      <h3>프로젝트</h3>
      {projects.map(([name, n]) => (
        <a class="cat" href={`/tags/${encodeURIComponent(name)}`}>
          <b>{name}</b><span>{n}</span>
        </a>
      ))}
    </nav>
  )}

  {categories.length > 0 && (
    <nav class="group">
      <h3>카테고리</h3>
      {categories.map(([name, n]) => (
        <a class="cat" href={`/tags/${encodeURIComponent(name)}`}>
          <b>{name}</b><span>{n}</span>
        </a>
      ))}
    </nav>
  )}

  <div class="visits">
    {analytics.goatcounter ? (
      <span data-visits>오늘 <span id="v-today">–</span> · 전체 <span id="v-total">–</span></span>
    ) : (
      <span>글 {posts.length}편 · {site.since}년부터</span>
    )}
  </div>
</aside>
